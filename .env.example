# ─────────────────────────────────────────────────────────────
# Lyria Health — environment variables
# Copy to .env and fill in.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Local dev:  postgresql://user:password@localhost:5432/lyria
# Vercel:     copy from Vercel Dashboard → Storage → your Neon database
#             (use the "pooled" connection string; it ends with -pooler)
DATABASE_URL=postgresql://user:password@host:5432/lyria?sslmode=require

# Bearer token protecting /api/admin/export (CSV) and /api/admin/delete.
# Generate one:  openssl rand -hex 32
ADMIN_TOKEN=

# Salt used to hash IP addresses in the consent log (raw IPs are never stored).
# Generate one:  openssl rand -hex 32
IP_HASH_SALT=

# Optional — Resend (https://resend.com, EU data residency).
# When absent the app runs in DEMO MODE: no emails are sent; the API returns
# the exact email HTML + a live confirm link so the double opt-in journey
# can be walked entirely in the browser.
RESEND_API_KEY=
CONFIRM_EMAIL_FROM="Lyria <hello@lyriahealth.co.uk>"

# Optional — override the base URL used in email links (defaults to request origin)
NEXT_PUBLIC_APP_URL=
